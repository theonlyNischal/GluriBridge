# Copy to .env (gitignored, never committed) in this same repo-root
# location and fill in real values. The backend loads this automatically
# on startup via python-dotenv (see backend/app/main.py) — nothing here
# is required for local dev with registry-only refreshes; the app runs
# fine with no .env file at all.

NVIDIA_API_KEY="..."

# Required only for the Sync page's "Full refresh (with news)" action
# (POST /refresh?with_news=true, backend/orchestrate.py) — enables
# Tavily-powered news discovery and Tier B contact resolution during a
# refresh. Without this set, GET /stats reports tavily_configured=false,
# the Sync page's news-enriched refresh option is disabled, and every
# refresh (manual or scheduler) stays registry-only, exactly as it
# always has. Real API credits are spent per search when this is used.
TAVILY_API_KEY="..."
