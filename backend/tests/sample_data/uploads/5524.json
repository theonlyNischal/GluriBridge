    "name": "Central Seram IFM RestorationWISE Project",
    "status": "Under validation (Public comment period closed)",
    "proponent": "Multiple Project Proponents",
    "authorized_rep_org": null,
    "sectoral_scope": "Agriculture Forestry and Other Land Use",
